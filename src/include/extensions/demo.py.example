# 漏洞插件模板 — 复制为 *.py 即被加载
# ------------------------------------------------------------------
# 因为后缀是 .py.example，extmgr 不会扫到这个文件 (load_extensions_from_directory
# 只匹配 *.py)。要启用，复制重命名为 my_vuln.py 之类，调一次
# vuln_reload_extensions 即可生效，无须重启。
#
# 推荐的插件结构 (照搬现有 vuln_sqli / vuln_cmdi / vuln_deser / vuln_reload):
#   1. 顶部注释写清楚:
#        - 教学目的 / 漏洞类别 / action 名
#        - config.toml 下的开关键名
#        - 典型 payload
#   2. 继承 RequestHandler，定义 data_schema 与 require_auth
#   3. handle() 第一行现读 global_config["vuln"]，未启用就 404，
#      这样 config 切换即时生效，不需要重新热插拔
#   4. 文件末尾用 @hookimpl 注册 action → handler 映射

from include.classes.connection_handler import ConnectionHandler
from include.classes.request_handler import RequestHandler
from include.conf_loader import global_config
from include.system.extmgr import hookimpl


class RequestVulnDemoHandler(RequestHandler):
    data_schema = {
        "type": "object",
        "properties": {"echo": {"type": "string"}},
        "required": ["echo"],
        "additionalProperties": False,
    }
    require_auth = True

    def handle(self, handler: ConnectionHandler):
        _vuln = global_config.get("vuln", {})
        # 改成你的开关键，例如 _vuln.get("my_vuln")
        if not (_vuln.get("enabled") and _vuln.get("demo")):
            handler.conclude_request(404, {}, "Unknown action")
            return 404, None, handler.username

        echo: str = handler.data["echo"]

        # TODO: 在这里实现你的不安全行为。下面只是回显，作为热插拔验证用的
        # "版本探针" —— 把 version 改成 2 后保存并 vuln_reload_extensions，
        # 客户端下次调用应当立刻看到 version=2。
        handler.conclude_request(
            200,
            {"echo": echo, "version": 1},
            "demo ok",
        )
        return 0, echo, handler.username


@hookimpl
def ext_register_handlers():
    return {"vuln_demo": RequestVulnDemoHandler}
